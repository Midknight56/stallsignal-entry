{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stallsignal",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    "PAYPAL_BASE": "https://api-m.sandbox.paypal.com"
  },
  // Set these as secrets: PAYPAL_CLIENT_ID, PAYPAL_SECRET, PAYPAL_WEBHOOK_ID.
  // DEV_ROUTES belongs only in .dev.vars and must not be set in production.
  "d1_databases": [
    { "binding": "DB", "database_name": "stallsignal", "database_id": "f74e736e-6457-4432-8b56-9d9e08db3317" },
    { "binding": "LEDGER", "database_name": "hackathon-ledger", "database_id": "023377a8-ad19-413c-b769-d195d05427b3", "remote": true }
  ],
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "public/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhooks/*", "/health"]
  }
}
